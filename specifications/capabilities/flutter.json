      "status": "requires-host-adapter",
      "requires": [
        "FilePickerAdapter",
        "UploadAdapter"
      ],
      "reason": "Flutter renderer wires selection, progress, cancel and asset refs, but ships no picker plugin."
    },
    "camera": {
      "status": "requires-host-adapter",

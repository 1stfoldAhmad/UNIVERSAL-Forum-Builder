{
    "name": "vds/form-laravel-renderer",
    "description": "VDS Universal Form Builder \u2014 Laravel 13 server-rendered form renderer (shared HTML contract + trusted submission).",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../execution-adapters/laravel",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "vds/form-laravel": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "laravel/framework": "Already required: the ServiceProvider/Blade/controller integration needs Laravel 13 (PHP ^8.3)."
    },
    "autoload": {
        "psr-4": {
            "VdsForm\\Renderer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VdsForm\\Renderer\\VdsFormRendererServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "php tests/run-renderer.php"
    }
}

{
    "name": "vds/form-laravel",
    "description": "VDS Universal Form Builder \u2014 Laravel/PHP trusted execution adapter (vds.expr/1 engine, server re-validation, fail-closed RBAC, scoped atomic idempotency, redacted audit).",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "illuminate/http": "^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "illuminate/http": "Required only for the LaravelController HTTP integration in a host app.",
        "ext-pdo_sqlite": "Enables the durable PdoIdempotencyStore reference and the durability test."
    },
    "autoload": {
        "psr-4": {
            "VdsForm\\": "src/"
        }
    },
    "scripts": {
        "conformance": "php tests/run-conformance.php",
        "test": [
            "php tests/run-conformance.php",
            "php tests/run-form-conformance.php",
            "php tests/run-asset-conformance.php",
            "php tests/run-idempotency-parity.php",
            "php tests/run-submission.php",
            "php tests/run-controller.php",
            "php tests/run-security.php",
            "php tests/run-security-policy.php",
            "php tests/run-remediation.php",
            "php tests/run-operation-limits.php",
            "php tests/run-idempotency-recovery.php"
        ]
    },
    "version": "1.1.0"
}

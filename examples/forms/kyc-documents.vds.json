{
  "format": "vds.form",
  "specVersion": "1.0.0",
  "id": "kyc-documents",
  "metadata": {
    "name": "KYC Documents",
    "version": "1.0.0"
  },
  "fields": [
    {
      "id": "fullName",
      "type": "text",
      "key": "kyc.fullName",
      "label": "Full name",
      "required": true
    },
    {
      "id": "idDocument",
      "type": "file",
      "key": "kyc.idDocument",
      "label": "ID document",
      "required": true,
      "validation": {
        "accept": [
          "image/png",
          "image/jpeg",
          "application/pdf"
        ],
        "maxSizeBytes": 10485760
      }
    },
    {
      "id": "selfie",
      "type": "image",
      "key": "kyc.selfie",
      "label": "Selfie",
      "required": true,
      "validation": {
        "accept": [
          "image/png",
          "image/jpeg"
        ],
        "maxSizeBytes": 5242880
      }
    },
    {
      "id": "proofDocs",
      "type": "file",
      "key": "kyc.proofDocs",
      "label": "Supporting documents",
      "validation": {
        "accept": [
          "application/pdf"
        ],
        "maxSizeBytes": 10485760,
        "multiple": true,
        "maxItems": 5
      }
    }
  ],
  "capabilities": {
    "required": [
      "file-upload"
    ]
  },
  "submission": {
    "operationRef": "test:kyc.submit"
  }
}
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@vds-form/types": ["packages/form-types/src/index.ts"],
      "@vds-form/spec": ["packages/form-spec/src/index.ts"],
      "@vds-form/expressions": ["packages/form-expressions/src/index.ts"],
      "@vds-form/fields": ["packages/form-field-registry/src/index.ts"],
      "@vds-form/compiler": ["packages/form-compiler/src/index.ts"],
      "@vds-form/validation": ["packages/form-validation/src/index.ts"],
      "@vds-form/runtime": ["packages/form-runtime/src/index.ts"],
      "@vds-form/data-sources": ["packages/form-data-sources/src/index.ts"],
      "@vds-form/persistence": ["packages/form-persistence/src/index.ts"],
      "@vds-form/submission": ["packages/form-submission/src/index.ts"],
      "@vds-form/plugins": ["packages/form-plugin-sdk/src/index.ts"],
      "@vds-form/inspector": ["packages/form-inspector/src/index.ts"],
      "@vds-form/migrations": ["packages/form-migrations/src/index.ts"],
      "@vds-form/core": ["packages/form-core/src/index.ts"],
      "@vds-form/conformance": ["packages/form-conformance/src/index.ts"],
      "@vds-form/react": ["adapters/react/src/index.ts"],
      "@vds-form/vue": ["adapters/vue/src/index.ts"],
      "@vds-form/angular": ["adapters/angular/src/index.ts"],
      "@vds-form/expo": ["adapters/expo/src/index.ts"],
      "@vds-form/execution-node": ["execution-adapters/node/src/index.ts"],
      "@vds-form/vds-logic": ["integrations/vds-logic/src/index.ts"],
      "@vds-form/vds-contracts": ["integrations/vds-contracts/src/index.ts"],
      "@vds-form/mcp": ["tools/mcp-server/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*", "packages/*/tests/**/*",
    "adapters/*/src/**/*", "adapters/*/tests/**/*",
    "execution-adapters/node/**/*",
    "integrations/*/src/**/*", "integrations/*/tests/**/*",
    "tools/*/src/**/*", "tools/*/tests/**/*",
    "examples/headless-node/**/*", "examples/react-app/src/**/*", "examples/react-app/tests/**/*",
    "examples/expo-app/src/**/*", "examples/expo-app/tests/**/*",
    "tests/**/*", "benchmarks/**/*", "scripts/**/*.ts", "vitest.workspace.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/node_modules", "execution-adapters/django", "execution-adapters/laravel", "vendor"]
}

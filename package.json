{
  "name": "vds-universal-form-builder",
  "version": "0.1.0",
  "private": true,
  "description": "VDS Universal Form Builder \u2014 one canonical JSON form standard, deterministic compiler, headless runtime, platform renderers and trusted execution adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "execution-adapters/node",
    "integrations/*",
    "tools/*",
    "examples/headless-node",
    "examples/react-app",
    "examples/expo-app",
    "examples/next-app"
  ],
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:web": "vitest run --project web",
    "test:native": "vitest run --project native",
    "test:angular": "vitest run --project angular",
    "typecheck": "tsc --noEmit",
    "cli": "tsx tools/cli/src/bin.ts",
    "bench": "tsx benchmarks/run.ts",
    "setup:vds": "bash scripts/fetch-vds-deps.sh",
    "test:django": "cd execution-adapters/django && python3 -m pytest -q",
    "test:laravel": "cd execution-adapters/laravel && php tests/run-conformance.php",
    "build:packages": "node scripts/build-packages.mjs",
    "pack:packages": "node scripts/pack-packages.mjs",
    "test:packages": "node scripts/package-smoke.mjs",
    "capabilities": "node --experimental-strip-types scripts/gen-capability-mirrors.mjs",
    "capabilities:check": "node --experimental-strip-types scripts/gen-capability-mirrors.mjs --check",
    "support-matrix": "node scripts/gen-support-matrix.mjs",
    "support-matrix:check": "node scripts/gen-support-matrix.mjs --check"
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "rxjs": "^7.8.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.44",
    "zod": "^3.25.76",
    "zone.js": "~0.15.0"
  }
}

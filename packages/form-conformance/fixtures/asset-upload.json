{
  "suite": "asset-upload",
  "specVersion": "1.0.0",
  "description": "Canonical file/image accept + size semantics. Extensions match the FILENAME; MIME tokens match a NORMALIZED MIME; either may be inferred from the other. Size limit is inclusive. Consumed identically by TypeScript, Python, PHP, Dart, Kotlin and Swift. Client metadata is a hint only: the trusted upload/storage provider remains authoritative for actual content.",
  "cases": [
    { "id": "jpg-ext-image-jpeg", "name": "photo.jpg", "mimeType": "image/jpeg", "accept": [".jpg"], "sizeBytes": 10, "maxSizeBytes": 1000, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "jpeg-ext-image-jpeg", "name": "photo.jpeg", "mimeType": "image/jpeg", "accept": [".jpeg"], "sizeBytes": 10, "maxSizeBytes": 1000, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "jpg-ext-accepts-jpeg-token", "name": "photo.jpg", "mimeType": "image/jpeg", "accept": [".jpeg"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "jpeg-ext-accepts-jpg-token", "name": "photo.jpeg", "mimeType": "image/jpeg", "accept": [".jpg"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "png-ext-image-png", "name": "scan.png", "mimeType": "image/png", "accept": [".png"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "pdf-ext-application-pdf", "name": "doc.pdf", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "uppercase-extension", "name": "PHOTO.JPG", "mimeType": "image/jpeg", "accept": [".jpg"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "uppercase-accept-extension", "name": "photo.jpg", "mimeType": "image/jpeg", "accept": [".JPG"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "uppercase-mime", "name": "photo.jpg", "mimeType": "IMAGE/JPEG", "accept": ["image/jpeg"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "uppercase-accept-mime", "name": "photo.jpg", "mimeType": "image/jpeg", "accept": ["IMAGE/JPEG"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "mime-with-parameters", "name": "notes.txt", "mimeType": "text/plain; charset=utf-8", "accept": ["text/plain"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "mime-alias-jpg", "name": "photo.dat", "mimeType": "image/jpg", "accept": ["image/jpeg"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "mime-alias-x-png", "name": "scan.dat", "mimeType": "image/x-png", "accept": ["image/png"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "missing-mime-known-extension", "name": "photo.jpg", "mimeType": "", "accept": ["image/jpeg"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "generic-mime-known-extension", "name": "doc.pdf", "mimeType": "application/octet-stream", "accept": ["application/pdf"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "missing-mime-wildcard", "name": "photo.png", "mimeType": "", "accept": ["image/*"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "no-extension-mime-infers-extension", "name": "download", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "wildcard-image", "name": "a.webp", "mimeType": "image/webp", "accept": ["image/*"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "wildcard-rejects-other-family", "name": "a.pdf", "mimeType": "application/pdf", "accept": ["image/*"], "sizeBytes": 10, "expect": { "typeAllowed": false, "sizeAllowed": true } },
    { "id": "unknown-extension-rejected", "name": "mystery.xyz", "mimeType": "", "accept": ["image/*"], "sizeBytes": 10, "expect": { "typeAllowed": false, "sizeAllowed": true } },
    { "id": "disallowed-mime-rejected", "name": "anim.gif", "mimeType": "image/gif", "accept": ["application/pdf"], "sizeBytes": 10, "expect": { "typeAllowed": false, "sizeAllowed": true } },
    { "id": "disallowed-extension-rejected", "name": "anim.gif", "mimeType": "image/gif", "accept": [".png", ".jpg"], "sizeBytes": 10, "expect": { "typeAllowed": false, "sizeAllowed": true } },
    { "id": "multiple-tokens-second-matches", "name": "doc.pdf", "mimeType": "application/pdf", "accept": ["image/png", "application/pdf"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "no-accept-allows-any", "name": "anything.bin", "mimeType": "application/x-unknown", "accept": [], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "extension-token-must-not-match-mime-substring", "name": "evil.png", "mimeType": "image/png", "accept": [".pdf"], "sizeBytes": 10, "expect": { "typeAllowed": false, "sizeAllowed": true } },
    { "id": "size-exactly-at-limit", "name": "doc.pdf", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 1000, "maxSizeBytes": 1000, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "size-one-over-limit", "name": "doc.pdf", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 1001, "maxSizeBytes": 1000, "expect": { "typeAllowed": true, "sizeAllowed": false } },
    { "id": "size-zero-allowed", "name": "empty.pdf", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 0, "maxSizeBytes": 1000, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "size-no-limit", "name": "huge.pdf", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 999999999, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "path-like-name-uses-basename", "name": "C:\\uploads\\report.PDF", "mimeType": "application/pdf", "accept": [".pdf"], "sizeBytes": 10, "expect": { "typeAllowed": true, "sizeAllowed": true } },
    { "id": "dotfile-has-no-extension", "name": ".gitignore", "mimeType": "", "accept": [".gitignore"], "sizeBytes": 10, "expect": { "typeAllowed": false, "sizeAllowed": true } }
  ]
}

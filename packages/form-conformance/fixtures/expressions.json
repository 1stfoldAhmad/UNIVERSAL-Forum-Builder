{
  "suite": "vds.expr/1",
  "specVersion": "1.0.0",
  "description": "Cross-language expression conformance. Every execution adapter (TypeScript, Django, Laravel) MUST reproduce these results exactly. Errors are values: {ok:false, code}. Null and undefined are equivalent (normalized to null).",
  "cases": [
    { "id": "add-numbers", "expr": { "op": "add", "args": [{ "const": 1 }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 3 } },
    { "id": "add-null-strict", "expr": { "op": "add", "args": [{ "const": 1 }, { "ref": "field:missing" }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_TYPE_ERROR" } },
    { "id": "sub", "expr": { "op": "sub", "args": [{ "const": 10 }, { "const": 3 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 7 } },
    { "id": "mul", "expr": { "op": "mul", "args": [{ "const": 3 }, { "const": 4 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 12 } },
    { "id": "div", "expr": { "op": "div", "args": [{ "const": 10 }, { "const": 4 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 2.5 } },
    { "id": "div-by-zero", "expr": { "op": "div", "args": [{ "const": 1 }, { "const": 0 }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_DIVISION_BY_ZERO" } },
    { "id": "mod", "expr": { "op": "mod", "args": [{ "const": 10 }, { "const": 3 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 1 } },
    { "id": "mod-by-zero", "expr": { "op": "mod", "args": [{ "const": 1 }, { "const": 0 }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_DIVISION_BY_ZERO" } },
    { "id": "sum-skips-null", "expr": { "op": "sum", "args": [{ "const": [1, null, 3] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 4 } },
    { "id": "sum-empty", "expr": { "op": "sum", "args": [{ "const": [] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 0 } },
    { "id": "avg", "expr": { "op": "avg", "args": [{ "const": [2, 4] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 3 } },
    { "id": "avg-empty-null", "expr": { "op": "avg", "args": [{ "const": [] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": null } },
    { "id": "min", "expr": { "op": "min", "args": [{ "const": [3, 1, 2] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 1 } },
    { "id": "max", "expr": { "op": "max", "args": [{ "const": [3, 1, 2] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 3 } },
    { "id": "count", "expr": { "op": "count", "args": [{ "const": [1, 2, 3] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 3 } },
    { "id": "eq-null-equiv-undefined", "expr": { "op": "eq", "args": [{ "ref": "field:missing" }, { "const": null }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "eq-deep-object", "expr": { "op": "eq", "args": [{ "const": { "a": 1 } }, { "const": { "a": 1 } }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "neq", "expr": { "op": "neq", "args": [{ "const": 1 }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "gt-numbers", "expr": { "op": "gt", "args": [{ "const": 3 }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "gt-iso-strings", "expr": { "op": "gt", "args": [{ "const": "2024-02-01" }, { "const": "2024-01-01" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "gte-equal", "expr": { "op": "gte", "args": [{ "const": 2 }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "lt", "expr": { "op": "lt", "args": [{ "const": 1 }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "and-strict-boolean", "expr": { "op": "and", "args": [{ "const": true }, { "const": 1 }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_TYPE_ERROR" } },
    { "id": "or", "expr": { "op": "or", "args": [{ "const": false }, { "const": true }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "not", "expr": { "op": "not", "args": [{ "const": false }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "if-true-branch", "expr": { "op": "if", "args": [{ "const": true }, { "const": "a" }, { "const": "b" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "a" } },
    { "id": "coalesce", "expr": { "op": "coalesce", "args": [{ "const": null }, { "const": null }, { "const": "x" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "x" } },
    { "id": "isNull-missing", "expr": { "op": "isNull", "args": [{ "ref": "field:missing" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "isEmpty-string", "expr": { "op": "isEmpty", "args": [{ "const": "" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "isEmpty-array", "expr": { "op": "isEmpty", "args": [{ "const": [] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "in-array", "expr": { "op": "in", "args": [{ "const": 2 }, { "const": [1, 2, 3] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "contains-string", "expr": { "op": "contains", "args": [{ "const": "hello" }, { "const": "ell" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "contains-array", "expr": { "op": "contains", "args": [{ "const": [1, 2] }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "concat-mixed", "expr": { "op": "concat", "args": [{ "const": "a" }, { "const": "b" }, { "const": 1 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "ab1" } },
    { "id": "len-string", "expr": { "op": "len", "args": [{ "const": "hello" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 5 } },
    { "id": "len-array", "expr": { "op": "len", "args": [{ "const": [1, 2] }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 2 } },
    { "id": "startsWith", "expr": { "op": "startsWith", "args": [{ "const": "hello" }, { "const": "he" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "endsWith", "expr": { "op": "endsWith", "args": [{ "const": "hello" }, { "const": "lo" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "lower", "expr": { "op": "lower", "args": [{ "const": "ABC" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "abc" } },
    { "id": "upper", "expr": { "op": "upper", "args": [{ "const": "abc" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "ABC" } },
    { "id": "trim", "expr": { "op": "trim", "args": [{ "const": "  x  " }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "x" } },
    { "id": "abs", "expr": { "op": "abs", "args": [{ "const": -5 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 5 } },
    { "id": "round-half-away-up", "expr": { "op": "round", "args": [{ "const": 2.5 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 3 } },
    { "id": "round-half-away-negative", "expr": { "op": "round", "args": [{ "const": -2.5 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": -3 } },
    { "id": "round-digits", "expr": { "op": "round", "args": [{ "const": 1.005 }, { "const": 2 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 1.01 } },
    { "id": "toNumber-string", "expr": { "op": "toNumber", "args": [{ "const": "42" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 42 } },
    { "id": "toNumber-bool", "expr": { "op": "toNumber", "args": [{ "const": true }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 1 } },
    { "id": "toNumber-invalid", "expr": { "op": "toNumber", "args": [{ "const": "abc" }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_TYPE_ERROR" } },
    { "id": "toString-null", "expr": { "op": "toString", "args": [{ "const": null }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "" } },
    { "id": "toString-number", "expr": { "op": "toString", "args": [{ "const": 42 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "42" } },
    { "id": "toBoolean-zero", "expr": { "op": "toBoolean", "args": [{ "const": 0 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": false } },
    { "id": "toBoolean-string", "expr": { "op": "toBoolean", "args": [{ "const": "x" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": true } },
    { "id": "dateAddDays-month-boundary", "expr": { "op": "dateAddDays", "args": [{ "const": "2024-01-31" }, { "const": 1 }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": "2024-02-01" } },
    { "id": "dateDiffDays", "expr": { "op": "dateDiffDays", "args": [{ "const": "2024-02-01" }, { "const": "2024-01-01" }] }, "scope": { "values": {} }, "expect": { "ok": true, "value": 31 } },
    { "id": "dateAddDays-invalid", "expr": { "op": "dateAddDays", "args": [{ "const": "not-a-date" }, { "const": 1 }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_TYPE_ERROR" } },
    { "id": "ref-field", "expr": { "ref": "field:x" }, "scope": { "values": { "x": 5 } }, "expect": { "ok": true, "value": 5 } },
    { "id": "ref-context", "expr": { "ref": "context:tenant" }, "scope": { "values": {}, "context": { "tenant": "acme" } }, "expect": { "ok": true, "value": "acme" } },
    { "id": "ref-missing-null", "expr": { "ref": "field:missing" }, "scope": { "values": {} }, "expect": { "ok": true, "value": null } },
    { "id": "overflow", "expr": { "op": "mul", "args": [{ "const": 1e308 }, { "const": 10 }] }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_OVERFLOW" } },
    { "id": "item-outside-row", "expr": { "ref": "item:qty" }, "scope": { "values": {} }, "expect": { "ok": false, "code": "EXPR_SCOPE_ERROR" } },
    { "id": "item-in-row", "expr": { "op": "mul", "args": [{ "ref": "item:qty" }, { "ref": "item:price" }] }, "scope": { "values": { "items": [{ "qty": 3, "price": 10 }] }, "rowPrefix": "items.0", "rowIndex": 0 }, "expect": { "ok": true, "value": 30 } },
    { "id": "index-in-row", "expr": { "ref": "index" }, "scope": { "values": {}, "rowPrefix": "items.0", "rowIndex": 2 }, "expect": { "ok": true, "value": 2 } }
  ]
}
